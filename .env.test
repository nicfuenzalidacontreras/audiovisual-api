# Configuración usada exclusivamente por los tests e2e (test/*.e2e-spec.ts).
# `test/env.setup.ts` carga este archivo sobrescribiendo el DATABASE_URL del
# entorno, para que los tests nunca corran contra la base de datos de
# desarrollo/producción configurada en `.env`.

# Mismo servidor MySQL que `.env`, pero un schema dedicado a pruebas
# (ver MYSQL_TEST_DATABASE en .env.example). El sufijo "_test" es obligatorio:
# scripts/prepare-test-db.ts se niega a operar si no lo tiene.
DATABASE_URL=mysql://audiovisual:audiovisual@mysql:3306/audiovisual_api_test

# Secretos de JWT — solo para tests, no usar en desarrollo ni producción.
JWT_ACCESS_SECRET=test-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
