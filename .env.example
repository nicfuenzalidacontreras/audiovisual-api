# App
PORT=3000

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=audiovisual_api
MYSQL_USER=audiovisual
MYSQL_PASSWORD=audiovisual
MYSQL_PORT=3306

# Cadena de conexión que usará la API (Prisma).
# El host "mysql" corresponde al nombre del servicio en docker-compose.yml.
DATABASE_URL=mysql://audiovisual:audiovisual@mysql:3306/audiovisual_api

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Mailpit (servidor SMTP de pruebas + UI web)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025

# Auth (JWT)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d